# Copy to .env (not committed) and point these at your own files.
# Used by the end-to-end tests and by `pnpm play`.
# The game executable, built with the PVZLAB option on.
PVZ_EXE=C:\path\to\pvz-lab\build-msvc\pvz-portable.exe
# A folder holding main.pak and the properties folder from your own copy of the game.
PVZ_RESDIR=C:\path\to\game-data
# A save folder to copy for each run (the original is never touched).
PVZ_SAVE_TEMPLATE=C:\path\to\save-template
# Optional: 1 runs the games the end-to-end tests launch without sound.
# PVZ_E2E_MUTE=1
# Optional: the Claude Code program that plays (`pnpm play`), if claude.exe isn't on your PATH.
# It must be a recent version: 2.1.23 never gave MCP tools to the model; 2.1.283 does.
# CLAUDE_BIN=C:\path\to\claude.exe
