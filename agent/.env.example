# Copy to .env (not committed) and point these at your own files. Used by the end-to-end tests.
# The game executable, built with the PVZLAB option on.
PVZ_EXE=C:\path\to\pvz-lab\build-msvc\pvz-portable.exe
# A folder holding main.pak and the properties folder from your own copy of the game.
PVZ_RESDIR=C:\path\to\game-data
# A save folder to copy for each run (the tests never touch the original).
PVZ_SAVE_TEMPLATE=C:\path\to\save-template
